# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — your real handle/URL/name/bio/videos never get committed.

TIKTOK_HANDLE=@your_handle
GITHUB_URL=https://github.com/your-username
FULL_NAME="Seu Nome"
ABOUT_BIO="Aqui fica uma breve história sobre você."

# Optional — URL of a hosted avatar photo (e.g. Vercel Blob). Falls back to
# an initial-letter placeholder if unset. See scripts/upload-to-blob.mjs.
AVATAR_URL=

# Your video gallery, as a single-line JSON array. Falls back to one generic
# placeholder entry if unset. `src` values come from scripts/upload-to-blob.mjs.
# VIDEOS_JSON='[{"id":"1234567890","title":"Meu vídeo","publishedAt":"2026-01-01","src":"https://your-blob-url/video.mp4"}]'
VIDEOS_JSON=

# Only needed locally to run scripts/upload-to-blob.mjs (uploads
# public/videos/*.mp4 and public/avatar.jpg to Vercel Blob). NOT needed by
# the deployed site itself — don't add this one to Vercel's env settings.
# Create a Blob store (access: Public) in the Vercel dashboard's Storage tab
# to get a token.
BLOB_READ_WRITE_TOKEN=
