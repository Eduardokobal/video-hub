# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# local tool settings (contains local machine paths — belt-and-suspenders on
# top of the global gitignore, so a future git add -A on any machine can't
# accidentally commit it)
.claude/*.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# personal media — hosted on Vercel Blob instead (see scripts/upload-to-blob.mjs),
# keeps this repo free of personal content now that it's public. Files stay
# on disk locally, just untracked.
/public/videos/
/public/avatar.jpg

# local-only AI-assistant guidance — public equivalent is DEVELOPMENT.md.
# Kept on disk locally, never committed.
/CLAUDE.md
