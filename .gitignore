# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# local tool settings (contains local machine paths — belt-and-suspenders on
# top of the global gitignore, so a future git add -A on any machine can't
# accidentally commit it)
.claude/*.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
